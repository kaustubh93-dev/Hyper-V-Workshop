{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]"
        },
        "hostCount": {
            "type": "int",
            "defaultValue": 2,
            "minValue": 1,
            "maxValue": 4
        },
        "namePrefix": {
            "type": "string",
            "defaultValue": "HYD-HOST",
            "maxLength": 13,
            "metadata": {
                "description": "Hosts are named <prefix>-1..N; kept short so the computer name stays within 15 chars."
            }
        },
        "vmSize": {
            "type": "string",
            "defaultValue": "Standard_E4s_v4",
            "allowedValues": [
                "Standard_D4s_v5",
                "Standard_D8s_v5",
                "Standard_E4s_v5",
                "Standard_E8s_v5",
                "Standard_D8s_v4",
                "Standard_E4s_v4"
            ],
            "metadata": {
                "description": "Sizes that support nested virtualization."
            }
        },
        "adminUsername": {
            "type": "string",
            "defaultValue": "labadmin"
        },
        "adminPassword": {
            "type": "secureString",
            "minLength": 12
        },
        "zone": {
            "type": "string",
            "defaultValue": "1",
            "allowedValues": [
                "1",
                "2",
                "3"
            ]
        },
        "osDiskType": {
            "type": "string",
            "defaultValue": "Premium_LRS",
            "allowedValues": [
                "Premium_LRS",
                "StandardSSD_LRS"
            ]
        },
        "dataDiskSizeGB": {
            "type": "int",
            "defaultValue": 1024,
            "minValue": 128,
            "maxValue": 4095
        },
        "dataDiskSku": {
            "type": "string",
            "defaultValue": "Premium_LRS",
            "allowedValues": [
                "Premium_LRS",
                "StandardSSD_LRS"
            ]
        },
        "vnetName": {
            "type": "string",
            "defaultValue": "vnet-hyperv-training"
        },
        "vnetAddressPrefix": {
            "type": "string",
            "defaultValue": "172.16.0.0/16"
        },
        "subnetName": {
            "type": "string",
            "defaultValue": "snet-hosts"
        },
        "subnetPrefix": {
            "type": "string",
            "defaultValue": "172.16.0.0/24"
        },
        "bastionSku": {
            "type": "string",
            "defaultValue": "Standard",
            "allowedValues": [
                "Developer",
                "Standard"
            ],
            "metadata": {
                "description": "Standard enables shareable links (browser RDP without Azure accounts) but needs a public IP. Developer needs no public IP but is portal-only."
            }
        },
        "bastionSubnetPrefix": {
            "type": "string",
            "defaultValue": "172.16.1.0/26",
            "metadata": {
                "description": "AzureBastionSubnet (min /26), used only with the Standard SKU."
            }
        },
        "autoShutdownTime": {
            "type": "string",
            "defaultValue": "21:00"
        },
        "autoShutdownTimeZone": {
            "type": "string",
            "defaultValue": "India Standard Time"
        },
        "autoShutdownNotificationEmail": {
            "type": "string",
            "defaultValue": ""
        },
        "hostSetupScript": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Contents of scripts/setup-host.ps1, supplied by deploy.ps1. Empty uses hostSetupScriptUri."
            }
        },
        "hostSetupScriptUri": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/kaustubh93-dev/Hyper-V-Workshop/main/scripts/setup-host.ps1"
        },
        "nestedNatPrefix": {
            "type": "string",
            "defaultValue": "192.168.0.0/24"
        },
        "deployMSLab": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Build MSLab on each host after Hyper-V setup: DC (corp.contoso.com) plus Server 2025 nodes. Runs in the background for ~1.5 h after the deployment finishes."
            }
        },
        "mslabNodeCount": {
            "type": "int",
            "defaultValue": 3,
            "minValue": 0,
            "maxValue": 6
        },
        "mslabNodeMemoryGB": {
            "type": "int",
            "defaultValue": 5,
            "minValue": 2,
            "maxValue": 16
        },
        "mslabSetupScript": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Contents of scripts/mslab-host.ps1, supplied by deploy.ps1. Empty uses mslabSetupScriptUri."
            }
        },
        "mslabSetupScriptUri": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/kaustubh93-dev/Hyper-V-Workshop/main/scripts/mslab-host.ps1"
        },
        "tags": {
            "type": "object",
            "defaultValue": {
                "purpose": "hyperv-training"
            }
        }
    },
    "variables": {
        "nsgName": "[format('{0}-nsg', parameters('namePrefix'))]",
        "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName'))]",
        "bastionName": "[format('{0}-bastion', parameters('vnetName'))]",
        "bastionPipName": "[format('{0}-bastion-pip', parameters('vnetName'))]",
        "isBastionStandard": "[equals(parameters('bastionSku'), 'Standard')]",
        "hostSubnet": {
            "name": "[parameters('subnetName')]",
            "properties": {
                "addressPrefix": "[parameters('subnetPrefix')]",
                "defaultOutboundAccess": true,
                "networkSecurityGroup": {
                    "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
                }
            }
        },
        "bastionSubnet": {
            "name": "AzureBastionSubnet",
            "properties": {
                "addressPrefix": "[parameters('bastionSubnetPrefix')]"
            }
        },
        "bastionStandardProperties": {
            "enableShareableLink": true,
            "ipConfigurations": [
                {
                    "name": "ipconfig1",
                    "properties": {
                        "subnet": {
                            "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'AzureBastionSubnet')]"
                        },
                        "publicIPAddress": {
                            "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPipName'))]"
                        }
                    }
                }
            ]
        },
        "bastionDeveloperProperties": {
            "virtualNetwork": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
            }
        }
    },
    "resources": [
        {
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2023-09-01",
            "name": "[variables('nsgName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "properties": {
                "securityRules": [
                    {
                        "name": "Allow-RDP-From-Bastion-Developer",
                        "properties": {
                            "priority": 300,
                            "protocol": "Tcp",
                            "access": "Allow",
                            "direction": "Inbound",
                            "sourceAddressPrefix": "168.63.129.16",
                            "sourcePortRange": "*",
                            "destinationAddressPrefix": "*",
                            "destinationPortRange": "3389"
                        }
                    },
                    {
                        "name": "Allow-RDP-From-Bastion-Subnet",
                        "properties": {
                            "priority": 310,
                            "protocol": "Tcp",
                            "access": "Allow",
                            "direction": "Inbound",
                            "sourceAddressPrefix": "[parameters('bastionSubnetPrefix')]",
                            "sourcePortRange": "*",
                            "destinationAddressPrefix": "*",
                            "destinationPortRange": "3389"
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "2024-05-01",
            "name": "[parameters('vnetName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
            ],
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "[parameters('vnetAddressPrefix')]"
                    ]
                },
                "subnets": "[if(variables('isBastionStandard'), createArray(variables('hostSubnet'), variables('bastionSubnet')), createArray(variables('hostSubnet')))]"
            }
        },
        {
            "condition": "[variables('isBastionStandard')]",
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "2024-05-01",
            "name": "[variables('bastionPipName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "sku": {
                "name": "Standard"
            },
            "properties": {
                "publicIPAllocationMethod": "Static"
            }
        },
        {
            "type": "Microsoft.Network/bastionHosts",
            "apiVersion": "2024-05-01",
            "name": "[variables('bastionName')]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]",
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPipName'))]"
            ],
            "sku": {
                "name": "[parameters('bastionSku')]"
            },
            "properties": "[if(variables('isBastionStandard'), variables('bastionStandardProperties'), variables('bastionDeveloperProperties'))]"
        },
        {
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "2023-09-01",
            "name": "[format('{0}-{1}-nic', parameters('namePrefix'), copyIndex(1))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "copy": {
                "name": "nicLoop",
                "count": "[parameters('hostCount')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
            ],
            "properties": {
                "enableAcceleratedNetworking": true,
                "ipConfigurations": [
                    {
                        "name": "ipconfig1",
                        "properties": {
                            "primary": true,
                            "privateIPAllocationMethod": "Dynamic",
                            "subnet": {
                                "id": "[variables('subnetId')]"
                            }
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "2024-07-01",
            "name": "[format('{0}-{1}', parameters('namePrefix'), copyIndex(1))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "copy": {
                "name": "vmLoop",
                "count": "[parameters('hostCount')]"
            },
            "zones": [
                "[parameters('zone')]"
            ],
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1}-nic', parameters('namePrefix'), copyIndex(1)))]"
            ],
            "properties": {
                "hardwareProfile": {
                    "vmSize": "[parameters('vmSize')]"
                },
                "storageProfile": {
                    "imageReference": {
                        "publisher": "MicrosoftWindowsServer",
                        "offer": "WindowsServer",
                        "sku": "2025-datacenter-g2",
                        "version": "latest"
                    },
                    "osDisk": {
                        "name": "[format('{0}-{1}-osdisk', parameters('namePrefix'), copyIndex(1))]",
                        "createOption": "FromImage",
                        "deleteOption": "Delete",
                        "managedDisk": {
                            "storageAccountType": "[parameters('osDiskType')]"
                        }
                    },
                    "dataDisks": [
                        {
                            "name": "[format('{0}-{1}-datadisk0', parameters('namePrefix'), copyIndex(1))]",
                            "lun": 0,
                            "createOption": "Empty",
                            "diskSizeGB": "[parameters('dataDiskSizeGB')]",
                            "caching": "ReadOnly",
                            "deleteOption": "Delete",
                            "managedDisk": {
                                "storageAccountType": "[parameters('dataDiskSku')]"
                            }
                        }
                    ]
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1}-nic', parameters('namePrefix'), copyIndex(1)))]",
                            "properties": {
                                "deleteOption": "Delete"
                            }
                        }
                    ]
                },
                "securityProfile": {
                    "securityType": "TrustedLaunch",
                    "uefiSettings": {
                        "secureBootEnabled": true,
                        "vTpmEnabled": true
                    }
                },
                "osProfile": {
                    "computerName": "[format('{0}-{1}', parameters('namePrefix'), copyIndex(1))]",
                    "adminUsername": "[parameters('adminUsername')]",
                    "adminPassword": "[parameters('adminPassword')]",
                    "windowsConfiguration": {
                        "enableAutomaticUpdates": false,
                        "provisionVMAgent": true,
                        "patchSettings": {
                            "patchMode": "Manual",
                            "assessmentMode": "ImageDefault"
                        }
                    }
                },
                "diagnosticsProfile": {
                    "bootDiagnostics": {
                        "enabled": true
                    }
                }
            }
        },
        {
            "type": "Microsoft.DevTestLab/schedules",
            "apiVersion": "2018-09-15",
            "name": "[format('shutdown-computevm-{0}-{1}', parameters('namePrefix'), copyIndex(1))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "copy": {
                "name": "shutdownLoop",
                "count": "[parameters('hostCount')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}', parameters('namePrefix'), copyIndex(1)))]"
            ],
            "properties": {
                "status": "Enabled",
                "taskType": "ComputeVmShutdownTask",
                "dailyRecurrence": {
                    "time": "[replace(parameters('autoShutdownTime'), ':', '')]"
                },
                "timeZoneId": "[parameters('autoShutdownTimeZone')]",
                "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}', parameters('namePrefix'), copyIndex(1)))]",
                "notificationSettings": {
                    "status": "[if(empty(parameters('autoShutdownNotificationEmail')), 'Disabled', 'Enabled')]",
                    "notificationLocale": "en",
                    "timeInMinutes": 30,
                    "emailRecipient": "[parameters('autoShutdownNotificationEmail')]"
                }
            }
        },
        {
            "type": "Microsoft.Compute/virtualMachines/runCommands",
            "apiVersion": "2024-07-01",
            "name": "[format('{0}-{1}/setup-hyperv', parameters('namePrefix'), copyIndex(1))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "copy": {
                "name": "setupLoop",
                "count": "[parameters('hostCount')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}', parameters('namePrefix'), copyIndex(1)))]"
            ],
            "properties": {
                "source": "[if(empty(parameters('hostSetupScript')), createObject('scriptUri', parameters('hostSetupScriptUri')), createObject('script', parameters('hostSetupScript')))]",
                "parameters": [
                    {
                        "name": "NatPrefix",
                        "value": "[parameters('nestedNatPrefix')]"
                    }
                ],
                "asyncExecution": false,
                "timeoutInSeconds": 3600,
                "treatFailureAsDeploymentFailure": true
            }
        },
        {
            "condition": "[parameters('deployMSLab')]",
            "type": "Microsoft.Compute/virtualMachines/runCommands",
            "apiVersion": "2024-07-01",
            "name": "[format('{0}-{1}/setup-mslab', parameters('namePrefix'), copyIndex(1))]",
            "location": "[parameters('location')]",
            "tags": "[parameters('tags')]",
            "copy": {
                "name": "mslabLoop",
                "count": "[parameters('hostCount')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines/runCommands', format('{0}-{1}', parameters('namePrefix'), copyIndex(1)), 'setup-hyperv')]"
            ],
            "properties": {
                "source": "[if(empty(parameters('mslabSetupScript')), createObject('scriptUri', parameters('mslabSetupScriptUri')), createObject('script', parameters('mslabSetupScript')))]",
                "parameters": [
                    {
                        "name": "NodeCount",
                        "value": "[string(parameters('mslabNodeCount'))]"
                    },
                    {
                        "name": "NodeMemoryGB",
                        "value": "[string(parameters('mslabNodeMemoryGB'))]"
                    }
                ],
                "asyncExecution": true,
                "timeoutInSeconds": 600,
                "treatFailureAsDeploymentFailure": false
            }
        }
    ],
    "outputs": {
        "hosts": {
            "type": "array",
            "copy": {
                "count": "[parameters('hostCount')]",
                "input": {
                    "name": "[format('{0}-{1}', parameters('namePrefix'), copyIndex(1))]",
                    "privateIp": "[reference(resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1}-nic', parameters('namePrefix'), copyIndex(1))), '2023-09-01').ipConfigurations[0].properties.privateIPAddress]"
                }
            }
        },
        "nextSteps": {
            "type": "string",
            "value": "[concat(if(parameters('deployMSLab'), 'MSLab builds in the background (~1.5 h); progress in C:\\MSLabSetup\\status.txt on each host. ', ''), if(variables('isBastionStandard'), format('Student browser access: portal > {0} > Shareable links > Add, or run scripts/bastion-links.ps1.', variables('bastionName')), 'Connect: portal > VM > Connect > Bastion.'))]"
        }
    }
}
